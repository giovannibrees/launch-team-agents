# Copy to .env for docker-compose. Only DOMAIN is required.
DOMAIN=adstudio.yourdomain.com

# Optional: require an invite code to sign up (keeps the URL from being open).
SIGNUP_CODE=

# Optional owner-wide fallback keys (shared by ALL users — prefer per-user keys
# entered in the app's Settings tab). Leave blank to run demo until users add keys.
EMBEDDING_PROVIDER=voyage
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=
# Image generation router. fal.ai = one key for Ideogram v3 (on-image text) +
# Seedream (cheap volume). OPENAI_API_KEY also powers gpt-image-1. Users can set
# their own keys in Settings instead. IMAGE_MODEL default: auto|ideogram|seedream|gpt-image.
FAL_API_KEY=
IMAGE_MODEL=auto

# Optional: upgrade the Forecast tab to Google's TimesFM (needs the model
# installed in the image — see docs/deploy-hetzner.md). Off = built-in baseline.
ENABLE_TIMESFM=

# Email (verification + password reset). Without SMTP, links are logged to the
# container and shown in-app (dev mode) — fine for testing, set SMTP for real.
APP_BASE_URL=https://adstudio.yourdomain.com   # used in email links
REQUIRE_VERIFICATION=                            # "1" to block use until verified
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ad Studio <noreply@yourdomain.com>
