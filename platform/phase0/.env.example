# Copy to .env and fill in for real runs. Omit entirely for --dry-run.

# --- LLM (persona reactions + persona generation) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Embeddings (the SSR similarity step) ---
# Voyage is Anthropic's recommended embeddings partner; OpenAI also supported.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3

# If using OpenAI embeddings instead:
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
